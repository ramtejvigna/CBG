# Shared dev image for the API and the web app.
# Source code is bind-mounted at runtime, so nothing is copied in here.
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Docker CLI only (no daemon): the API starts sandbox containers through the host's socket
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker

WORKDIR /app
