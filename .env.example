# Copy to .env (optional). Every value has a working default, so `docker compose up` works without this file.

# Ports on your machine
WEB_PORT=3000
API_PORT=5000
DB_PORT=5433
REDIS_PORT=6379

# Admin login created by the seed: admin@cbg.com / this password (min 12 chars)
SEED_ADMIN_PASSWORD=LocalAdmin-ChangeMe1

# NextAuth: generate with `openssl rand -base64 32` if you like
NEXTAUTH_SECRET=local-dev-secret-change-me

# Google sign-in (optional; leave empty to use email + password only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password-reset emails (optional)
EMAIL_USER=
EMAIL_PASS=
